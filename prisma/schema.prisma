model ShippingRate {
  id            String   @id @default(uuid())
  countryCode   String   @unique @map("country_code")   // ISO 코드 (US, JP, CN...)
  countryName   String   @map("country_name")
  ratePerKg     Float    @map("rate_per_kg")            // kg당 배송비 (USD)
  baseRate      Float    @map("base_rate")              // 최소 배송비 (USD)
  estimatedDays String   @map("estimated_days")         // 예상 배송일 (예: "7-14")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order") // 표시 순서
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("shipping_rates")
}

// HS Code별 관세율 테이블
model HsCodeRate {
  id          String   @id @default(uuid())
  hsCode      String   @unique @map("hs_code")          // HS 코드 (2-6자리)
  description String                                    // 설명 (예: "Clothing - Knitted")
  dutyRate    Float    @map("duty_rate")                // 관세율 (0.05 = 5%)
  notes       String?                                   // 메모
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("hs_code_rates")
}

// 국가별 세금 테이블
model CountryTaxRate {
  id            String   @id @default(uuid())
  countryCode   String   @unique @map("country_code")   // ISO 코드
  countryName   String   @map("country_name")
  salesTaxRate  Float    @map("sales_tax_rate")         // VAT/GST 세율 (0.10 = 10%)
  taxName       String   @map("tax_name")               // "VAT", "GST", "Sales Tax"
  dutyThreshold Float    @map("duty_threshold")         // 관세 면제 기준 (USD)
  taxThreshold  Float    @map("tax_threshold")          // 세금 면제 기준 (USD)
  notes         String?                                 // 메모 (예: "Section 321")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("country_tax_rates")
}

// ═══════════════════════════════════════════════════════════════════════════════
// FTA (Free Trade Agreement) 세율 테이블
// 원산지-목적지-HS Code 조합에 따른 협정 세율
// ═══════════════════════════════════════════════════════════════════════════════
model FtaRate {
  id                 String    @id @default(uuid())
  originCountry      String    @map("origin_country")       // 원산지 ISO 코드 (KR, CN, VN 등)
  destinationCountry String    @map("destination_country")  // 목적지 ISO 코드 (US, JP 등)
  hsCodePrefix       String    @map("hs_code_prefix")       // HS 코드 접두사 (2-6자리)
  preferentialRate   Float     @map("preferential_rate")    // 협정 세율 (0.0 = 무관세)
  ftaName            String    @map("fta_name")             // 협정명 (KORUS, RCEP, CPTPP 등)
  validFrom          DateTime  @map("valid_from")           // 유효 시작일
  validUntil         DateTime? @map("valid_until")          // 유효 종료일 (null = 무기한)
  notes              String?                                // 메모 (특수 조건 등)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([originCountry, destinationCountry, hsCodePrefix, ftaName])
  @@index([originCountry, destinationCountry])
  @@index([hsCodePrefix])
  @@map("fta_rates")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 관세청 UNI-PASS API 캐시
// HS Code 검증 및 세율 조회 결과 캐싱
// ═══════════════════════════════════════════════════════════════════════════════
model UnipassCache {
  id          String   @id @default(uuid())
  hsCode      String   @unique @map("hs_code")    // 조회한 HS 코드
  queryType   String   @map("query_type")         // "verify" | "search" | "rate"
  response    Json                                 // API 응답 전체 (JSON)
  isValid     Boolean  @default(true) @map("is_valid")  // 유효한 코드인지
  hsCode6     String?  @map("hs_code_6")          // 6자리 국제 공통 코드
  description String?                              // 품명
  dutyRate    Float?   @map("duty_rate")          // 기본 관세율
  queriedAt   DateTime @default(now()) @map("queried_at")
  expiresAt   DateTime @map("expires_at")         // 24시간 TTL

  @@index([hsCode])
  @@index([expiresAt])
  @@map("unipass_cache")
}

// ═══════════════════════════════════════════════════════════════════════════════
// GTIN (바코드) 조회 캐시
// EAN-Search.org, GS1 GEPIR 등 바코드 기반 상품 정보 캐싱
// ═══════════════════════════════════════════════════════════════════════════════
model GTINCache {
  id            String   @id @default(uuid())
  gtin          String   @unique                   // GTIN/EAN/UPC 바코드
  manufacturer  String?                            // 제조사명
  productName   String?  @map("product_name")      // 상품명
  countryPrefix String?  @map("country_prefix")    // GS1 국가코드 (원산지 추정용)
  weightKg      Float?   @map("weight_kg")         // 무게
  dimensions    Json?                              // { l, w, h } 치수
  category      String?                            // 카테고리
  response      Json?                              // 원본 API 응답
  source        String   @default("ean-search")    // "ean-search" | "gs1-gepir"
  queriedAt     DateTime @default(now()) @map("queried_at")
  expiresAt     DateTime @map("expires_at")        // 30일 TTL

  @@index([gtin])
  @@index([expiresAt])
  @@map("gtin_cache")
}

// LLM 사용량 추적 - API 호출, 토큰, 비용 추적
model LlmUsage {
  id            String   @id @default(uuid())

  // Provider & Model Info
  provider      String                    // "gemini", "lm-studio", "openai"
  model         String                    // "gemini-2.5-flash", "gpt-4o-mini", etc.
  apiKeyHash    String?  @map("api_key_hash")  // Hash of API key (first 8 chars for identification)

  // Token Usage
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
  totalTokens   Int      @map("total_tokens")

  // Cost Calculation (USD)
  inputCost     Float    @map("input_cost")    // Based on provider pricing
  outputCost    Float    @map("output_cost")
  totalCost     Float    @map("total_cost")

  // Request Context
  sessionId     String?  @map("session_id")
  actionType    String?  @map("action_type")   // "search", "show_product", etc.

  // Performance
  latencyMs     Int?     @map("latency_ms")
  success       Boolean  @default(true)
  errorMessage  String?  @map("error_message")

  createdAt     DateTime @default(now()) @map("created_at")

  // Individual indexes
  @@index([provider])
  @@index([createdAt])
  @@index([sessionId])
  // Composite indexes for analytics queries
  @@index([sessionId, createdAt])    // Session usage history: WHERE sessionId ORDER BY createdAt
  @@index([provider, createdAt])     // Provider analytics: WHERE provider AND createdAt BETWEEN
  @@map("llm_usage")
}

// 외부 API 사용량 추적 - Scraper, Tavily, Naver 등
model ApiUsage {
  id            String   @id @default(uuid())

  // Service Identification
  service       String                    // "browserless", "scrapingbee", "tavily", "naver", "local"
  operation     String                    // "scrape", "search", "enrich", etc.

  // Request Details
  endpoint      String?                   // API endpoint or URL scraped
  method        String   @default("GET")  // HTTP method

  // Response Info
  statusCode    Int?     @map("status_code")
  success       Boolean  @default(true)
  errorMessage  String?  @map("error_message")

  // Performance
  latencyMs     Int?     @map("latency_ms")

  // Cost Tracking (estimated based on service pricing)
  costUsd       Float?   @map("cost_usd")  // Estimated cost in USD
  credits       Int?                       // Credits used (for ScrapingBee)

  // Context
  sessionId     String?  @map("session_id")
  productUrl    String?  @map("product_url")  // Related product URL if applicable

  // Metadata (flexible JSON for service-specific data)
  metadata      Json?                      // Additional service-specific info

  createdAt     DateTime @default(now()) @map("created_at")

  // Indexes for analytics
  @@index([service])
  @@index([createdAt])
  @@index([service, createdAt])           // Service usage over time
  @@index([service, success])             // Error rate by service
  @@index([sessionId])
  @@map("api_usage")
}

// 스크래퍼 캐시 - HTML 및 파싱 결과 캐싱
model ScraperCache {
  id          String    @id @default(uuid())
  url         String    @unique                    // 원본 URL
  urlHash     String    @unique @map("url_hash")   // MD5 hash of URL (for quick lookup)
  contentType String    @map("content_type")       // "html" or "parsed"

  // HTML 캐시 데이터
  html        String?                              // Raw HTML content (nullable for parsed-only entries)
  htmlLength  Int?      @map("html_length")        // HTML 길이

  // 파싱 결과 캐시
  parsedData  Json?     @map("parsed_data")        // Parsed product data as JSON
  parserUsed  String?   @map("parser_used")        // "structured", "llm", or "fallback"

  // 메타데이터
  fetchedAt   DateTime  @map("fetched_at")         // 가져온 시간
  expiresAt   DateTime  @map("expires_at")         // 만료 시간 (24시간 TTL)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([urlHash])
  @@index([expiresAt])
  @@map("scraper_cache")
}

// Tavily 검색 결과 캐시 - 중복 API 호출 방지
model TavilyCache {
  id        String   @id @default(uuid())
  queryHash String   @unique @map("query_hash")   // MD5 hash of query
  query     String                                 // 원본 검색어
  results   Json                                   // Tavily API 응답 결과
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")           // 7일 TTL

  @@index([queryHash])
  @@index([expiresAt])
  @@map("tavily_cache")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Scraper Domain Stats (적응형 학습 데이터 영속화)
// 도메인별 백엔드 성공률, 응답시간, 선호 백엔드 저장
// 서버 재시작 시에도 학습 데이터 유지
// ═══════════════════════════════════════════════════════════════════════════════
model ScraperDomainStats {
  id               String   @id @default(uuid())
  domain           String   @unique               // 도메인명 (e.g., "www.coupang.com")
  stats            Json                            // { [backend]: { attempts, successes, failures, avgResponseTime, blockRate } }
  preferredBackend String?  @map("preferred_backend")  // 적응형 학습으로 선택된 최적 백엔드
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([domain])
  @@map("scraper_domain_stats")
}

// 챗 메타데이터 로깅 - 분석 및 Explainable AI 지원
model ChatLog {
  id                String   @id @default(uuid())

  // 요청 컨텍스트
  sessionId         String   @map("session_id")
  userId            String?  @map("user_id")
  userMessage       String   @map("user_message")    // 사용자 입력 (분석용)
  messageIndex      Int      @map("message_index")   // 대화 내 위치

  // 의도 분류
  routerUsed        String   @map("router_used")     // "semantic" | "llm"
  routerConfidence  Float?   @map("router_confidence")
  actionType        String?  @map("action_type")     // search, show_product 등
  actionParams      Json?    @map("action_params")   // 추출된 파라미터

  // LLM 정보
  llmModel          String?  @map("llm_model")
  reasoning         String?                          // 추론 과정 텍스트

  // 토큰 사용량
  inputTokens       Int?     @map("input_tokens")    // 입력 토큰 수
  outputTokens      Int?     @map("output_tokens")   // 출력 토큰 수

  // 도구 사용 정보
  toolsUsed         Json?    @map("tools_used")      // [{ tool, action, duration, success }]

  // UI 렌더링
  uiComponentTypes  String[] @map("ui_component_types")
  productUrls       String[] @map("product_urls")

  // 성능
  processingTimeMs  Int      @map("processing_time_ms")

  // 상태
  success           Boolean  @default(true)
  errorCode         String?  @map("error_code")
  errorMessage      String?  @map("error_message")

  // 가드레일
  guardrailWarnings String[] @map("guardrail_warnings")

  createdAt         DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([actionType])
  @@index([createdAt])
  @@index([success])
  @@index([sessionId, createdAt])  // 세션별 시간순 조회
  @@map("chat_logs")
}

// 관리자 설정/운영 액션 감사 로그
model AdminAuditLog {
  id             String   @id @default(uuid())
  adminUserId    String?  @map("admin_user_id")
  adminUserEmail String?  @map("admin_user_email")
  action         String
  target         String   @default("admin_settings")
  targetId       String?  @map("target_id")
  changes        Json
  requestMeta    Json?    @map("request_meta")
  createdAt      DateTime @default(now()) @map("created_at")

  adminUser      User?    @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([target])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// Shopify webhook 수신/처리 관측 로그
model ShopifyWebhookEvent {
  id                String   @id @default(uuid())
  webhookId         String?  @map("webhook_id")
  topic             String
  shopDomain        String?  @map("shop_domain")
  shopifyOrderId    String?  @map("shopify_order_id")
  quoteId           String?  @map("quote_id")
  correlationStatus String   @default("UNKNOWN") @map("correlation_status")
  processingStatus  String   @default("RECEIVED") @map("processing_status")
  httpStatus        Int?     @map("http_status")
  processingMs      Int?     @map("processing_ms")
  errorMessage      String?  @map("error_message")
  payload           Json?
  createdAt         DateTime @default(now()) @map("created_at")
  processedAt       DateTime? @map("processed_at")

  @@index([topic])
  @@index([shopifyOrderId])
  @@index([quoteId])
  @@index([correlationStatus])
  @@index([processingStatus])
  @@index([createdAt])
  @@map("shopify_webhook_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Sprint 4.1: Resumable SSE Stream State
// SSE 스트림 중단 시 이벤트 복원을 위한 상태 저장
// ═══════════════════════════════════════════════════════════════════════════════
model StreamState {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  status      String   @default("active")               // "active" | "completed" | "error"
  events      Json     @default("[]")                    // 저장된 SSE 이벤트 배열
  lastEventAt DateTime @default(now()) @map("last_event_at")
  expiresAt   DateTime @map("expires_at")                // TTL (기본 5분)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("stream_states")
}

model SessionEventLog {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  eventType String   @map("event_type")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([sessionId, createdAt])
  @@index([expiresAt])
  @@map("session_event_logs")
}

model ResearchTask {
  id                String             @id @default(uuid())
  userId            String?            @map("user_id")
  sessionId         String?            @map("session_id")
  productId         String?            @map("product_id")
  taskType          String             @default("deep_research") @map("task_type")
  query             String?
  title             String?
  status            ResearchTaskStatus @default(QUEUED)
  summary           String?
  result            Json?
  errorMsg          String?            @map("error_msg")
  metadata          Json?
  leaseOwner        String?            @map("lease_owner")
  leaseExpiresAt    DateTime?          @map("lease_expires_at")
  heartbeatAt       DateTime?          @map("heartbeat_at")
  startedAt         DateTime?          @map("started_at")
  completedAt       DateTime?          @map("completed_at")
  cancelRequestedAt DateTime?          @map("cancel_requested_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([sessionId, createdAt])
  @@index([productId])
  @@index([status, createdAt])
  @@map("research_tasks")
}

model ScraplingShadowObservation {
  id         String   @id @default(uuid())
  taskId     String?  @map("task_id")
  url        String
  domain     String
  mode       String
  hardDomain Boolean  @default(false) @map("hard_domain")
  accepted   Boolean
  success    Boolean?
  signal     String?
  reason     String?
  durationMs Int?     @map("duration_ms")
  fields     Json?
  diagnostics Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([domain, createdAt])
  @@index([url, createdAt])
  @@map("scrapling_shadow_observations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Sprint 4.2: Long-term User Memory
// 세션 횡단 구매 패턴, 브랜드 선호도 등 장기 기억
// ═══════════════════════════════════════════════════════════════════════════════
model UserMemory {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  category   String                        // "brand_preference" | "price_range" | "purchase_pattern" | "style"
  key        String                        // 구체적 키 (e.g., "favorite_brand", "avg_price")
  value      Json                          // 값 (유연한 JSON)
  confidence Float    @default(0.5)        // 신뢰도 (0-1, 미사용 시 감소)
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, category, key])
  @@index([userId])
  @@index([confidence])
  @@map("user_memories")
}

