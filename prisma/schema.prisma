generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  shopifyCustomerId   String?             @map("shopify_customer_id")
  notificationPref    NotificationChannel @default(EMAIL) @map("notification_pref")
  phone               String?
  isAdmin             Boolean             @default(false) @map("is_admin")
  createdAt           DateTime            @default(now()) @map("created_at")
  quotes              Quote[]
  chatSessions        ChatSession[]
  preferences         UserPreferences?
  adminAuditLogs      AdminAuditLog[]     @relation("AdminAuditActor")
  cart                Cart?
  orders              Order[]
  deliveryProfile     DeliveryProfile?
  purchaseRequests    PurchaseRequest[]

  @@map("users")
}

// URL purchase flow. Historical chat/order tables remain for data preservation only.
model DeliveryProfile {
  userId        String   @id @map("user_id")
  encryptedData String   @map("encrypted_data")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("delivery_profiles")
}

model PurchaseRequest {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  sourceUrl         String   @map("source_url")
  category          String
  quantity          Int
  options           String
  destination       String
  encryptedDelivery String   @map("encrypted_delivery")
  idempotencyKey    String   @map("idempotency_key")
  payloadHash       String   @map("payload_hash")
  status            String   @default("REVIEW_REQUIRED")
  version           Int      @default(0)
  review            Json?
  quote             Json?
  quoteExpiresAt    DateTime? @map("quote_expires_at")
  paymentDraftId    String?  @unique @map("payment_draft_id")
  checkoutUrl       String?  @map("checkout_url")
  paymentOrderId    String?  @unique @map("payment_order_id")
  paidAt            DateTime? @map("paid_at")
  carrier           String?
  trackingNumber    String?  @map("tracking_number")
  lastCarrierEventAt DateTime? @map("last_carrier_event_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User @relation(fields: [userId], references: [id])
  events            PurchaseEvent[]
  supportTickets    PurchaseSupportTicket[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("purchase_requests")
}

model PurchaseEvent {
  id         String @id @default(uuid())
  requestId  String @map("request_id")
  actorId    String @map("actor_id")
  source     String
  status     String
  message    String
  createdAt  DateTime @default(now()) @map("created_at")
  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt])
  @@index([requestId, status])
  @@map("purchase_events")
}

model PurchaseSupportTicket {
  id         String @id @default(uuid())
  requestId  String @map("request_id")
  subject    String
  message    String
  reply      String?
  status     String @default("OPEN")
  version    Int @default(0)
  updatedBy  String? @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt])
  @@index([status, createdAt])
  @@map("purchase_support_tickets")
}

model PurchaseQuota {
  key    String
  bucket DateTime
  count  Int
  @@id([key, bucket])
  @@map("purchase_quotas")
}

model PurchaseWebhookReceipt {
  id        String @id
  provider  String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("purchase_webhook_receipts")
}

// 유저 선호도 - LLM이 참조하는 영구 메모리
model UserPreferences {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")

  // 쇼핑 선호도 (LLM이 자유롭게 업데이트)
  favoriteCategories  String?  @map("favorite_categories")  // JSON string: ["K-pop", "Snacks"]
  dislikedCategories  String?  @map("disliked_categories")  // JSON string: ["Electronics"]
  pricePreference     String?  @map("price_preference")     // "budget", "mid-range", "premium"
  preferredBrands     String?  @map("preferred_brands")     // JSON string: ["BTS", "Blackpink"]

  // 배송 선호도
  defaultCountry      String?  @map("default_country")
  defaultAddress      Json?    @map("default_address")

  // LLM이 학습한 자유 형식 메모
  // 예: "이 사용자는 선물용 구매가 많고, 빠른 배송을 선호함"
  llmNotes            String?  @map("llm_notes")

  // 대화 스타일 선호 (LLM이 감지)
  communicationStyle  String?  @map("communication_style")  // "formal", "casual", "brief"
  language            String   @default("auto")             // "ko", "en", "auto"

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model ScrapeRequest {
  id                String       @id @default(uuid())
  userId            String?      @map("user_id")
  sessionId         String?      @map("session_id")
  productId         String?      @map("product_id")  // 성공 시 Product에 연결
  sourceUrl         String       @map("source_url")
  status            ScrapeStatus @default(PENDING)
  requestType       String       @default("direct") @map("request_type")
  tempProductId     String?      @map("temp_product_id")
  rawHtml           String?      @map("raw_html")
  parsedData        Json?        @map("parsed_data")
  errorMsg          String?      @map("error_msg")
  attempts          Int          @default(0)
  leaseOwner        String?      @map("lease_owner")
  leaseExpiresAt    DateTime?    @map("lease_expires_at")
  heartbeatAt       DateTime?    @map("heartbeat_at")
  startedAt         DateTime?    @map("started_at")
  completedAt       DateTime?    @map("completed_at")
  cancelRequestedAt DateTime?    @map("cancel_requested_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  product           Product?     @relation(fields: [productId], references: [id])

  @@index([status, createdAt])
  @@index([sourceUrl, status])
  @@index([leaseExpiresAt])
  @@index([sessionId])

  @@map("scrape_requests")
}

model ProductTask {
  id              String            @id @default(uuid())
  requestId       String?           @unique @map("request_id")
  userId          String?           @map("user_id")
  sessionId       String?           @map("session_id")
  productId       String?           @map("product_id")
  sourceUrl       String            @map("source_url")
  taskType        String            @default("product_evidence") @map("task_type")
  status          ProductTaskStatus @default(PREVIEW)
  quoteReady      Boolean           @default(false) @map("quote_ready")
  previewProductId String?          @map("preview_product_id")
  missingFields   Json?             @map("missing_fields")
  errorMsg        String?           @map("error_msg")
  metadata        Json?
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([sourceUrl, status])
  @@index([sessionId, createdAt])
  @@index([productId])
  @@map("product_tasks")
}

model Product {
  id               String        @id @default(uuid())

  // URL 관련 (핵심) - sourceUrl이 유니크 키
  sourceUrl        String        @unique @map("source_url")      // 정규화된 URL
  sourceUrlHash    String        @unique @map("source_url_hash") // MD5 해시 (빠른 조회)
  originalUrl      String?       @map("original_url")            // 원본 URL (트래킹 파라미터 포함)

  // 상품 정보
  // NOTE: @unique 제거됨 - 여러 Product가 같은 Shopify Product를 공유 (N:1 via CanonicalProduct)
  shopifyProductId String?       @map("shopify_product_id")
  shopifyVariantId String?       @map("shopify_variant_id")    // Shopify 상품 Variant ID
  shopifySyncedAt  DateTime?     @map("shopify_synced_at")     // 마지막 Shopify 동기화 시간
  name             String
  imageUrl         String        @map("image_url")
  priceKrw         Float         @map("price_krw")
  salePriceKrw     Float?        @map("sale_price_krw")
  category         String
  options          Json?
  weightKg         Float         @map("weight_kg")
  dimensions       Json?
  domesticShipping Float         @default(0) @map("domestic_shipping")
  hsCode           String?       @map("hs_code")

  // Phase 2: 3-Tier Cascade에서 추출되는 확장 메타데이터
  description      String?                        // JSON-LD에서 추출된 상품 설명
  brand            String?                        // 브랜드명
  rating           Float?                         // 평균 평점 (0-5)
  reviewCount      Int?          @map("review_count") // 리뷰 수
  inStock          Boolean?      @default(true) @map("in_stock") // 재고 상태

  // Phase 3: Tavily Enrichment 필드
  material         String?                        // 재질 (e.g., "Cotton 95%, Spandex 5%")
  origin           String?                        // 원산지 (e.g., "South Korea", "China")
  enrichedAt       DateTime?     @map("enriched_at")  // 마지막 Tavily enrichment 시간
  enrichmentSource String?       @map("enrichment_source")  // "tavily" | "scraper" | "manual"

  // Phase 4: Data Source Tracking
  dataSources      Json?         @map("data_sources")       // ProductDataSources - 각 필드별 출처/신뢰도
  overallConfidence Float?       @map("overall_confidence") // 전체 신뢰도 (0-1)
  extractionMethod String?       @map("extraction_method")  // 'json-ld' | 'css' | 'llm' | 'manual'

  // 메타데이터
  lastScrapedAt    DateTime      @default(now()) @map("last_scraped_at")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  scrapeRequests   ScrapeRequest[]
  quotes           Quote[]
  cartItems        CartItem[]

  // Canonical Product 연결 (하이브리드 아키텍처)
  canonicalProductId String?   @map("canonical_product_id")
  canonicalProduct   CanonicalProduct? @relation(fields: [canonicalProductId], references: [id])

  // 가격 추적 (최저가 비교용)
  lastPriceCheck     DateTime? @map("last_price_check")
  priceHistory       Json?     @map("price_history")  // [{ date, priceKrw }]

  // === v6.0 Identity Fields ===
  sku                String?                      // 상품 고유번호
  releaseDate        String?   @map("release_date") // "YYYY-MM"
  season             String?                      // SS25 / FW25 / AW25
  listPriceKrw       Int?      @map("list_price_krw")     // 판매가
  discountPriceKrw   Int?      @map("discount_price_krw") // 할인가

  // === v6.0 Compliance Flags ===
  dgClass            String?   @map("dg_class")          // IATA DG Class
  inspectionRequired Boolean   @default(false) @map("inspection_required")

  // === v6.0 Internal-only (백오피스 전용) ===
  internalMetadata   Json?     @map("internal_metadata")
  // { maxBenefit: { priceKrw, method, url, rewardPoints }, crossPlatform: [...], dg, inspection }

  // === v2.0 Scrape Level Tracking ===
  scrapeLevel        ScrapeLevel @default(L0_UNKNOWN) @map("scrape_level")
  fieldProvenance    Json?      @map("field_provenance")  // { fieldName: { level, at, source } }
  catalogEntryId     String?    @map("catalog_entry_id")  // v2.0 Catalog 연결

  // === v2.0 Relations (추가) ===
  catalogMatches     CatalogMatch[]

  @@index([sourceUrlHash])
  @@index([canonicalProductId])
  @@index([brand, sku])
  @@index([catalogEntryId])
  @@index([scrapeLevel])
  @@map("products")
}

// Canonical Product - 동일 상품의 다중 URL 그룹화
// 하이브리드 아키텍처: PayNShip (가격/URL) + Shopify (카탈로그)
model CanonicalProduct {
  id                   String    @id @default(uuid())
  canonicalHash        String    @unique @map("canonical_hash")  // MD5(name + category + imageUrl)
  name                 String                                     // 대표 상품명 (Admin 표시용)
  shopifyProductId     String    @unique @map("shopify_product_id")  // Shopify Product GID
  shopifyVariantId     String    @map("shopify_variant_id")         // Default variant

  // 최저가 추적
  lowestPriceProductId String?   @map("lowest_price_product_id")
  lowestPriceKrw       Int?      @map("lowest_price_krw")
  lowestPriceUpdatedAt DateTime? @map("lowest_price_updated_at")

  // Relations
  products          Product[]   // Multiple PayNShip Products (다중 URL)

  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("canonical_products")
}

model Quote {
  id                     String   @id @default(uuid())
  productId              String?  @map("product_id")
  userId                 String?  @map("user_id")
  productName            String?  @map("product_name")
  // Snapshot of product data for order fulfillment (JSON)
  // Contains: name, imageUrl, sourceUrl, priceKrw, category, weightKg, selectedOptions
  productSnapshot        Json?    @map("product_snapshot")
  // For cart orders: snapshot of all cart items
  cartSnapshot           Json?    @map("cart_snapshot")
  destinationCountry     String   @map("destination_country")
  destinationAddress     Json     @map("destination_address")
  productPriceUsd        Float    @map("product_price_usd")
  serviceFee             Float    @map("service_fee")
  domesticShippingUsd    Float    @map("domestic_shipping_usd")
  internationalShipping  Float    @map("international_shipping")
  customsDuty            Float    @map("customs_duty")
  vat                    Float
  totalUsd               Float    @map("total_usd")
  exchangeRate           Float    @map("exchange_rate")
  validUntil             DateTime @map("valid_until")

  // Shopify Integration (Draft Order → Checkout)
  shopifyDraftId         String?  @unique @map("shopify_draft_id")  // Shopify Draft Order ID
  invoiceUrl             String?  @map("invoice_url")               // Shopify Checkout URL

  createdAt              DateTime @default(now()) @map("created_at")
  product                Product? @relation(fields: [productId], references: [id])
  user                   User?    @relation(fields: [userId], references: [id])
  orders                 Order[]
  orderIntents           OrderIntent[]
  paymentRequests        PaymentRequest[]

  // PERF: userId 인덱스 추가 - memory-loader.ts에서 user의 주문 조회 시 필요
  @@index([userId])
  @@map("quotes")
}

model Order {
  id                    String      @id @default(uuid())
  userId                String      @map("user_id")
  quoteId               String?     @map("quote_id")
  shopifyOrderId        String?     @unique @map("shopify_order_id")
  shopifyFulfillmentId  String?     @map("shopify_fulfillment_id")
  status                OrderStatus @default(PENDING_PAYMENT)

  // ── Phase 1: 상품 구매 결제 ──
  productAmountKrw      Int?        @map("product_amount_krw")
  productAmountUsd      Float?      @map("product_amount_usd")
  serviceFeeUsd         Float?      @map("service_fee_usd")
  domesticShippingKrw   Int?        @map("domestic_shipping_krw")
  domesticShippingUsd   Float?      @map("domestic_shipping_usd")
  phase1TotalUsd        Float?      @map("phase1_total_usd")
  phase1PaidAt          DateTime?   @map("phase1_paid_at")
  phase1PaymentRef      String?     @map("phase1_payment_ref")
  shopifyPhase1DraftId  String?     @map("shopify_phase1_draft_id")
  // Phase 2 estimates at checkout time (reference only)
  estimatedShippingUsd  Float?      @map("estimated_shipping_usd")
  estimatedDutyUsd      Float?      @map("estimated_duty_usd")
  estimatedTaxUsd       Float?      @map("estimated_tax_usd")

  // ── Warehouse: 창고 처리 ──
  warehouseReceivedAt   DateTime?   @map("warehouse_received_at")
  actualWeightKg        Float?      @map("actual_weight_kg")
  actualDimensions      Json?       @map("actual_dimensions")       // {l,w,h} cm
  volumetricWeightKg    Float?      @map("volumetric_weight_kg")
  chargeableWeightKg    Float?      @map("chargeable_weight_kg")    // MAX(actual, volumetric)
  warehouseNotes        String?     @map("warehouse_notes")
  warehousePhotos       Json?       @map("warehouse_photos")        // URL[]
  consolidationGroupId  String?     @map("consolidation_group_id")

  // ── Phase 2: 배송비 정산 ──
  intlShippingUsd       Float?      @map("intl_shipping_usd")
  customsDutyUsd        Float?      @map("customs_duty_usd")
  taxUsd                Float?      @map("tax_usd")
  packagingFeeUsd       Float?      @map("packaging_fee_usd")
  phase2TotalUsd        Float?      @map("phase2_total_usd")
  phase2PaidAt          DateTime?   @map("phase2_paid_at")
  phase2PaymentRef      String?     @map("phase2_payment_ref")
  shopifyPhase2DraftId  String?     @map("shopify_phase2_draft_id")
  phase2RequestedAt     DateTime?   @map("phase2_requested_at")
  phase2DueAt           DateTime?   @map("phase2_due_at")

  // ── Shipping tracking ──
  trackingNumber        String?     @map("tracking_number")          // legacy compat
  trackingNumberKr      String?     @map("tracking_number_kr")
  trackingNumberIntl    String?     @map("tracking_number_intl")
  shippingCarrier       String?     @map("shipping_carrier")
  shippingMethod        String?     @map("shipping_method")          // EMS, K-Packet, etc.
  estimatedDeliveryAt   DateTime?   @map("estimated_delivery_at")

  // ── Customer/Address ──
  destinationCountry    String?     @map("destination_country")
  shippingAddress       Json?       @map("shipping_address")
  customerNotes         String?     @map("customer_notes")

  // ── Snapshot ──
  cartSnapshot          Json?       @map("cart_snapshot")
  exchangeRate          Float?      @map("exchange_rate")

  // ── Denormalized query fields (populated by service layer) ──
  shipmentStatus        String?     @map("shipment_status")
  refundStatus          String?     @map("refund_status")
  refundAmountUsd       Float?      @map("refund_amount_usd")

  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  quote                 Quote?      @relation(fields: [quoteId], references: [id])
  user                  User        @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([consolidationGroupId])
  @@map("orders")
}

model OrderIntent {
  id                String            @id @default(uuid())
  quoteId           String?           @map("quote_id")
  userId            String?           @map("user_id")
  sessionId         String?           @map("session_id")
  status            OrderIntentStatus @default(PENDING_REVIEW)
  quoteQuality      String            @default("unknown") @map("quote_quality")
  checkoutEligible  Boolean           @default(false) @map("checkout_eligible")
  totalUsd          Float             @map("total_usd")
  currency          String            @default("USD")
  destinationCountry String?          @map("destination_country")
  acceptanceReason  String?           @map("acceptance_reason")
  reviewSummary     String?           @map("review_summary")
  paymentRequestId  String?           @map("payment_request_id")
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  quote             Quote?            @relation(fields: [quoteId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("order_intents")
}

model PaymentRequest {
  id               String               @id @default(uuid())
  orderIntentId    String               @map("order_intent_id")
  quoteId          String?              @map("quote_id")
  userId           String?              @map("user_id")
  status           PaymentRequestStatus @default(READY)
  amountUsd        Float                @map("amount_usd")
  currency         String               @default("USD")
  shopifyDraftId   String?              @map("shopify_draft_id")
  invoiceUrl       String?              @map("invoice_url")
  expiresAt        DateTime?            @map("expires_at")
  metadata         Json?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  quote            Quote?               @relation(fields: [quoteId], references: [id])

  @@index([quoteId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("payment_requests")
}

model ProcurementBatch {
  id               String                  @id @default(uuid())
  status           ProcurementBatchStatus  @default(DRAFT)
  sourceVendor     String?                 @map("source_vendor")
  selectedSourceUrl String?                @map("selected_source_url")
  orderIntentIds   Json?                   @map("order_intent_ids")
  operatorUserId   String?                 @map("operator_user_id")
  metadata         Json?
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("procurement_batches")
}

model ProcurementTask {
  id               String                 @id @default(uuid())
  batchId          String?                @map("batch_id")
  orderIntentId    String?                @map("order_intent_id")
  canonicalProductId String?              @map("canonical_product_id")
  status           ProcurementTaskStatus  @default(QUEUED)
  selectedSourceUrl String?               @map("selected_source_url")
  lowestPriceKrw   Float?                 @map("lowest_price_krw")
  availabilityStatus String?              @map("availability_status")
  reviewSummary    String?                @map("review_summary")
  metadata         Json?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  // === v2.0 9-step fields ===
  orderId          String?  @map("order_id")
  productId        String?  @map("product_id")
  selectedVariantOptions Json? @map("selected_variant_options")
  quantity         Int?

  // Step 1B 입력
  sellerUrl             String?   @map("seller_url")
  sellerOrderNumber     String?   @map("seller_order_number")
  sellerPaymentMethod   String?   @map("seller_payment_method")
  sellerFinalPaidKrw    Int?      @map("seller_final_paid_krw")
  procuredAt            DateTime? @map("procured_at")

  // Step 1C
  domesticTrackingNumber String?  @map("domestic_tracking_number")
  domesticCarrier        String?  @map("domestic_carrier")
  domesticShipStartedAt  DateTime? @map("domestic_ship_started_at")
  domesticDeliveredAt    DateTime? @map("domestic_delivered_at")

  // Step 1D
  failureType            String?  @map("failure_type")              // CANCELLED | OUT_OF_STOCK
  failureDetectedAt      DateTime? @map("failure_detected_at")
  reprocureApprovedAt    DateTime? @map("reprocure_approved_at")

  // Step 1F (검수)
  inspectionLevel        String?  @map("inspection_level")          // BASIC | DETAIL
  inspectionResult       Json?    @map("inspection_result")
  warehousedAt           DateTime? @map("warehoused_at")

  // Step 1G (해외발송)
  intlShipmentId         String?  @map("intl_shipment_id")
  intlTrackingNumber     String?  @map("intl_tracking_number")
  intlCarrier            String?  @map("intl_carrier")
  intlShippedAt          DateTime? @map("intl_shipped_at")

  // SLA
  stepStartedAt          DateTime? @map("step_started_at")
  slaDeadline            DateTime? @map("sla_deadline")

  @@index([batchId, createdAt(sort: Desc)])
  @@index([orderIntentId, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([status, slaDeadline])
  @@map("procurement_tasks")
}

model ChatSession {
  id                  String    @id @default(uuid())
  userId              String?   @map("user_id")
  isGuest             Boolean   @default(false) @map("is_guest")
  title               String    @default("New Chat")
  // @deprecated - Use Message relation instead. Kept for migration compatibility.
  messagesJson        String?   @map("messages")
  currentStep         String    @map("current_step")
  context             Json?
  lastViewedProductId String?   @map("last_viewed_product_id")
  lastSearchResults   Json?     @map("last_search_results")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  // Soft delete: null = active, timestamp = deleted
  // Prevents accidental data loss when user deletes session
  deletedAt           DateTime? @map("deleted_at")
  // Sprint 3.4: Conversation tags
  tags                String[]  @default([])
  user                User?     @relation(fields: [userId], references: [id])
  // Normalized message storage (replaces messagesJson)
  messages            Message[]

  // Performance indexes for common queries
  @@index([userId, updatedAt(sort: Desc)])  // User session list: WHERE userId ORDER BY updatedAt DESC
  @@index([isGuest, createdAt])             // Guest session cleanup queries
  @@index([deletedAt])                       // Soft delete queries
  @@map("chat_sessions")
}

// Normalized message storage for better query performance and scalability
model Message {
  id              String    @id @default(uuid())
  sessionId       String    @map("session_id")
  sender          String    // 'user' | 'bot'
  content         String    @db.Text
  metadata        Json?     // uiComponents, thinking, feedback, etc.
  createdAt       DateTime  @default(now()) @map("created_at")

  // Sprint 3.1: Conversation Branching
  parentMessageId String?   @map("parent_message_id")
  isActive        Boolean   @default(true) @map("is_active")
  editedAt        DateTime? @map("edited_at")

  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent          Message?    @relation("MessageTree", fields: [parentMessageId], references: [id])
  children        Message[]   @relation("MessageTree")

  // Efficient queries: session messages, feedback analysis
  @@index([sessionId, createdAt], map: "messages_session_created_asc")
  @@index([sessionId, createdAt(sort: Desc)], map: "messages_session_created_desc")
  @@index([parentMessageId])
  @@map("messages")
}

model Cart {
  id          String     @id @default(uuid())
  // Global cart ownership: userId (logged-in) OR guestToken (anonymous)
  userId      String?    @unique @map("user_id")
  guestToken  String?    @unique @map("guest_token")
  subtotalKrw Int?       @map("subtotal_krw")
  subtotalUsd Float?     @map("subtotal_usd")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@map("carts")
}

model CartItem {
  id                    String   @id @default(uuid())
  cartId                String   @map("cart_id")
  productId             String?  @map("product_id")
  name                  String
  imageUrl              String?  @map("image_url")
  priceKrw              Float    @map("price_krw")  // Float to match Product.priceKrw
  sourceUrl             String   @map("source_url")
  category              String   @default("other")
  weightKg              Float    @default(0.5) @map("weight_kg")
  hsCode                String   @default("9999.99") @map("hs_code")
  // Shipping detail fields (snapshot from Product)
  dimensions            Json?    // { l: number, w: number, h: number } in cm
  origin                String?  // Country of origin
  material              String?  // Material/fabric composition
  // Data source tracking for each field
  dataSources           Json?    @map("data_sources") // { weight: DataSource, hsCode: DataSource, ... }
  selectedOptions       Json?    @map("selected_options")
  optionPriceAdjustment Float    @default(0) @map("option_price_adjustment")  // Float for price consistency
  quantity              Int      @default(1)

  // 주문 시 스냅샷 (하이브리드 아키텍처: 어떤 URL에서 주문했는지 추적)
  orderedSourceUrl      String?  @map("ordered_source_url")   // 주문 시점 선택된 URL
  orderedPriceKrw       Float?   @map("ordered_price_krw")    // 주문 시점 가격

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  cart                  Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product               Product? @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

