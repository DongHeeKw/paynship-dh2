  @@index([orderId])
  @@index([quoteId])
  @@map("line_items")
}

// v1.1 Policy Integration — 신한은행 10am 환율 + Admin 조정
model ExchangeRate {
  id              String   @id @default(uuid())
  currencyCode    String   @map("currency_code")
  baseCurrency    String   @default("KRW") @map("base_currency")
  shinhanRate     Float    @map("shinhan_rate")
  adminAdjustment Float    @default(0) @map("admin_adjustment")
  effectiveRate   Float    @map("effective_rate")
  capturedAt      DateTime @map("captured_at")
  expiresAt       DateTime @map("expires_at")
  source          String   @default("SHINHAN_BANK_10AM")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([currencyCode, expiresAt])
  @@map("exchange_rates")
}

// v1.1 — 지원 통화 목록
model SupportedCurrency {
  code              String   @id                                // ISO 4217
  displayName       String   @map("display_name")
  symbol            String
  active            Boolean  @default(true)
  defaultForCountry String[] @map("default_for_country")
  sortOrder         Int      @default(0) @map("sort_order")

  @@map("supported_currencies")
}

// v1.1 — 반품 요청 + SLA 타이머
model ReturnRequest {
  id                String    @id @default(uuid())
  orderId           String    @map("order_id")
  requestedAt       DateTime  @map("requested_at")
  approvedAt        DateTime? @map("approved_at")
  rejectedAt        DateTime? @map("rejected_at")
  shippingDeadline  DateTime? @map("shipping_deadline")        // approved + 7 cal days
  arrivalDeadline   DateTime? @map("arrival_deadline")         // shipped + 14 cal days
  unboxingVideoUrl  String    @map("unboxing_video_url")
  reason            String
  internalRuling    String?   @map("internal_ruling")          // DEFECT | ABUSE | WEAR
  refundAmountUsd   Float?    @map("refund_amount_usd")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@index([shippingDeadline])
  @@index([arrivalDeadline])
  @@map("return_requests")
}

// v1.1 — Detail 검수 문제 발견 시 72h 고객 응답
model InspectionResponse {
  id                  String    @id @default(uuid())
  orderId             String    @map("order_id")
  sellerCode          String    @map("seller_code")
  findings            Json                                     // { photos, notes, severity }
  notifiedAt          DateTime  @map("notified_at")
  responseDeadline    DateTime  @map("response_deadline")      // notifiedAt + 72h
  customerChoice      String?   @map("customer_choice")        // SHIP_AS_IS | EXCHANGE | REFUND
  respondedAt         DateTime? @map("responded_at")
  defaultApplied      Boolean   @default(false) @map("default_applied")
  resolution          String?
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([responseDeadline, respondedAt])
  @@index([orderId])
  @@map("inspection_responses")
}

// v1.1 — Abandonment 결정 기록
model AbandonmentLog {
  id                    String   @id @default(uuid())
  orderId               String   @unique @map("order_id")
  detectedAt            DateTime @map("detected_at")
  customerNotifiedAt    DateTime @map("customer_notified_at")
  customerChoice        String?  @map("customer_choice")        // PAY_EXTRA | RETURN_TO_KR | ABANDON | null
  reshipCostUsd         Float    @map("reship_cost_usd")
  reinspectionFeeKrw    Int      @map("reinspection_fee_krw")
  sellerReturnFeeKrw    Int      @map("seller_return_fee_krw")
  productValueKrw       Int      @map("product_value_krw")
  systemRecommendation  String   @map("system_recommendation")  // ABANDON | RETURN
  approvedBy            String?  @map("approved_by")
  approvedAt            DateTime? @map("approved_at")
  finalDecision         String   @map("final_decision")         // ABANDON | RETURN
  executedAt            DateTime? @map("executed_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("abandonment_logs")
}

// v1.1 — Chargeback Incident + Blacklist (Phase 1)
model ChargebackIncident {
  id              String    @id @default(uuid())
  orderId         String    @map("order_id")
  userId          String?   @map("user_id")
  email           String
  pgProvider      String    @map("pg_provider")                 // PortOne | PayPal
  pgCaseId        String    @map("pg_case_id")
  reasonCode      String    @map("reason_code")
  amountUsd       Float     @map("amount_usd")
  openedAt        DateTime  @map("opened_at")
  resolvedAt      DateTime? @map("resolved_at")
  pgOutcome       String?   @map("pg_outcome")                  // won | lost | pending
  internalRuling  String?   @map("internal_ruling")             // FAIR | ABUSE | FRAUD
  adminNote       String?   @map("admin_note")
  actorId         String?   @map("actor_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([userId])
  @@map("chargeback_incidents")
}

model BlacklistEntry {
  id              String    @id @default(uuid())
  matchType       String    @map("match_type")                  // EMAIL | PAYMENT_HASH | ADDRESS | IP
  matchValue      String    @map("match_value")
  severity        String                                         // OBSERVATION | BLOCKED
  reason          String                                         // ABUSE | FRAUD | MANUAL
  linkedIncidentId String?  @map("linked_incident_id")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String    @map("created_by")

  @@unique([matchType, matchValue])
  @@index([matchType])
  @@map("blacklist_entries")
}

// v2.0 — Catalog (브랜드+상품명+SKU 기반 그룹)
model CatalogEntry {
  id                String    @id @default(uuid())
  catalogId         String    @unique @map("catalog_id")        // hash(brand+name+sku)
  brand             String
  productName       String    @map("product_name")
  sku               String?
  primaryUrl        String?   @map("primary_url")
  primaryProductId  String?   @map("primary_product_id")
  imageUrl          String?   @map("image_url")
  category          String?
  releaseDate       String?   @map("release_date")
  season            String?
  lowestPriceKrw    Int?      @map("lowest_price_krw")
  lowestPriceScanAt DateTime? @map("lowest_price_scan_at")
  confidence        Float
  unmatched         Boolean   @default(false)
  minScrapeLevel    ScrapeLevel? @map("min_scrape_level")
  maxScrapeLevel    ScrapeLevel? @map("max_scrape_level")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  matches           CatalogMatch[]
  scans             ProductCrossPlatformScan[]

  @@index([brand, sku])
  @@index([unmatched])
  @@map("catalog_entries")
}

// v2.0 — Product ↔ Catalog 매칭 (AI + Manual)
model CatalogMatch {
  id              String   @id @default(uuid())
  catalogEntryId  String   @map("catalog_entry_id")
  productId       String   @map("product_id")
  matchType       String   @map("match_type")                    // AUTO_EXACT | AUTO_FUZZY | MANUAL
  confidence      Float
  matchedBy       String?  @map("matched_by")                     // MANUAL일 때 actor userId
  matchedAt       DateTime @default(now()) @map("matched_at")

  entry           CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id])

  @@unique([catalogEntryId, productId])
  @@index([productId])
  @@map("catalog_matches")
}

// v2.0 — Cross-Platform 최저가 스캔 이력
model ProductCrossPlatformScan {
  id                 String   @id @default(uuid())
  catalogEntryId     String   @map("catalog_entry_id")
  platform           String                                       // coupang | naver | gmarket...
  url                String
  priceKrw           Int      @map("price_krw")
  maxBenefitPriceKrw Int?     @map("max_benefit_price_krw")
  benefitMethod      String?  @map("benefit_method")
  observedAt         DateTime @default(now()) @map("observed_at")

  entry              CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  @@index([catalogEntryId, observedAt])
  @@map("product_cross_platform_scans")
}

// v2.0 — AcrossB 국제 배송 Shipment (합배송 박스당 1송장)
model AcrossBShipment {
  id                     String    @id @default(uuid())
  orderId                String    @map("order_id")
  boxMasterId            String?   @map("box_master_id")
  acrossbShipmentId      String    @unique @map("acrossb_shipment_id")
  acrossbTrackingNumber  String    @map("acrossb_tracking_number")
  carrier                String                                    // YAMATO | FEDEX | UPS | DHL
  destinationCountry     String    @map("destination_country")     // ISO2
  weightKg               Float     @map("weight_kg")
  dimensions             Json
  packedItems            Json      @map("packed_items")            // [{ productId, qty, hsCode, origin }]
  createdAt              DateTime  @default(now()) @map("created_at")
  shippedAt              DateTime? @map("shipped_at")
  deliveredAt            DateTime? @map("delivered_at")
  status                 String                                    // CREATED | IN_TRANSIT | DELIVERED | EXCEPTION

  @@index([orderId])
  @@map("acrossb_shipments")
}
