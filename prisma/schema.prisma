// 카테고리별 추정값 매핑 (무게, 치수, HS Code)
model CategoryMapping {
  id                String   @id @default(uuid())
  category          String   @unique               // "fashion", "beauty", "electronics" 등
  displayName       String   @map("display_name")  // "패션", "뷰티", "전자제품"
  aliases           String[] @default([])          // 퍼지 매칭용 별칭 ["cloth", "clothing", "의류"]
  estimatedWeightKg Float    @default(0.5) @map("estimated_weight_kg")  // 추정 무게 (kg)
  dimensionL        Float    @default(30) @map("dimension_l")   // 추정 길이 (cm)
  dimensionW        Float    @default(20) @map("dimension_w")   // 추정 너비 (cm)
  dimensionH        Float    @default(10) @map("dimension_h")   // 추정 높이 (cm)
  hsCodePrefix      String   @default("99") @map("hs_code_prefix")  // HS 코드 2자리 (예: "62" = 의류)
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("category_mappings")
}

