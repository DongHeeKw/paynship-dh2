# First certificate issuance only; no customer API traffic until TLS is ready.
# Replace __DOMAIN__ with the verified DNS name before installation.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;
    client_max_body_size 8k;
    access_log off;
    location / { return 404; }
}
