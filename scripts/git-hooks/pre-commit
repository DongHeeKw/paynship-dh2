#!/bin/bash
# PayNShip v2 — pre-commit hook
#
# 3 가드레일 (G1, G2, G4) 통합. 우회: git commit --no-verify
#
# 설치: scripts/git-hooks/install.sh
# 위치: scripts/git-hooks/pre-commit (git-tracked) → .git/hooks/pre-commit (symlink)
#
# 참고: docs/briefing.md > Step 5 가드레일 코드화

set -eu

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

fail() {
  echo -e "${RED}❌ pre-commit blocked:${NC} $1" >&2
  echo -e "${YELLOW}우회:${NC} git commit --no-verify (불가피한 경우만)" >&2
  exit 1
}

# ─── G1: Commit author 검증 ──────────────────────────────────────────────
# Vercel Hobby plan team configuration 요구사항
# 이전 사고: 잘못된 author로 push → build 거부 → amend + force push

EXPECTED_NAME="paynshipcompany"
EXPECTED_EMAIL="277602128+paynshipcompany@users.noreply.github.com"

AUTHOR_IDENT=$(git var GIT_AUTHOR_IDENT 2>/dev/null || echo "")
AUTHOR_EMAIL=$(echo "$AUTHOR_IDENT" | sed -nE 's/.*<([^>]+)>.*/\1/p')
AUTHOR_NAME=$(echo "$AUTHOR_IDENT" | sed -nE 's/^([^<]*[^ <])[ ]*<.*/\1/p')

if [ "$AUTHOR_EMAIL" != "$EXPECTED_EMAIL" ] || [ "$AUTHOR_NAME" != "$EXPECTED_NAME" ]; then
  fail "Commit author = '$AUTHOR_NAME <$AUTHOR_EMAIL>' (잘못됨)
  필수: '$EXPECTED_NAME <$EXPECTED_EMAIL>'
  Vercel Hobby team configuration 요구. 잘못된 author로 push 시 build 거부됨.

  해결:
    git -c user.name='$EXPECTED_NAME' -c user.email='$EXPECTED_EMAIL' commit ...
  또는 영구 설정 (이 repo 전용):
    git config user.name '$EXPECTED_NAME'
    git config user.email '$EXPECTED_EMAIL'"
fi

# ─── G2: .env* 파일 staging 차단 ─────────────────────────────────────────
# 이전 사고: commit a5513a9에 .env.vercel.production secrets 노출

FORBIDDEN_ENVS=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)\.env($|\.)' \
  | grep -vE '\.env\.(example|sample|template)$' \
  || true)

if [ -n "$FORBIDDEN_ENVS" ]; then
  fail "다음 .env* 파일이 staged 됐습니다:
$(echo "$FORBIDDEN_ENVS" | sed 's/^/    /')
  Secrets 노출 위험. .env.example/.env.sample/.env.template만 commit 허용.

  해결:
    git restore --staged <파일>
  또는 .gitignore 에 추가."
fi

# ─── G4: Staged TS/TSX 변경 시 type-check ───────────────────────────────
# 이전 사고: inngest 업그레이드 후 Supabase ssr 타입 깨짐 → Vercel build 실패

STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(ts|tsx)$' \
  || true)

if [ -n "$STAGED_TS" ]; then
  echo -e "${GREEN}[pre-commit]${NC} TS/TSX 변경 감지 ($(echo "$STAGED_TS" | wc -l | tr -d ' ')개 파일), type-check 실행..."
  # pnpm type-check은 전체 tsc — 큰 변경은 답답할 수 있음
  if ! pnpm type-check >/dev/null 2>&1; then
    echo -e "${RED}━━━ type-check 실패 ━━━${NC}" >&2
    pnpm type-check 2>&1 | tail -20 >&2
    fail "type-check 에러 위 참조"
  fi
  echo -e "${GREEN}[pre-commit]${NC} type-check ✓"
fi

# ─── 통과 ────────────────────────────────────────────────────────────────
exit 0
