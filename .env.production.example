# PayNShip production template. API mutations fail closed without shared rate limits.
# Copy this template locally and fill secrets there. Never commit real values.

# Database: transaction pooler for runtime; direct/session connection for migrations.
DATABASE_URL="postgresql://paynship_app.[PROJECT_REF]:[RUNTIME_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://paynship_app.[PROJECT_REF]:[RUNTIME_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase authentication.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# PII encryption key: exactly 64 hexadecimal characters. Keep migration-owner credentials outside app runtime.
# Generate PII_ENCRYPTION_KEY with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=""

# Explicit role mapping; account must also have isAdmin=true in the database.
ADMIN_SUPER_ADMINS=""
ADMIN_OPERATORS=""
ADMIN_VIEWERS=""

# Shared throttling: optional for local UI; REQUIRED for every production API instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Reviewed quotes use hosted Shopify checkout. No card credentials are stored here.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_API_VERSION="2026-07"

# Optional carrier gateway: signed events are verified before delivery status changes.
SHIPPING_WEBHOOK_SECRET=""

# Optional email/invoice/operations integrations.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@paynship.com"
INVOICE_SELLER_NAME="PayNShip"
INVOICE_SELLER_ADDRESS="Seoul, Republic of Korea"
